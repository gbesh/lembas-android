<?xml version="1.0" encoding="utf-8"?>
<!-- The Lembas widget for other home apps: the look's scene, the time and the Shire date -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Lembas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:padding="14dp">

        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:textSize="34sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:shadowColor="#66000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/widget_shire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:shadowColor="#66000000"
            android:shadowRadius="8" />
    </LinearLayout>
</FrameLayout>
